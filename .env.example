# Copy this file to .env.local. Do not commit .env.local or real credentials.
# All values below are placeholders and are read only by server-side code.
LLM_PROVIDER=your-provider-name
LLM_MODEL=your-model-or-endpoint-id
LLM_API_KEY=replace-with-server-side-key
LLM_BASE_URL=https://example.invalid/api
DOUBAO_API_KEY=replace-with-server-side-key
DOUBAO_MODEL_ID=your-doubao-endpoint-id
DOUBAO_BASE_URL=https://example.invalid/api/v3
KV_REST_API_URL=https://example.invalid/vercel-kv-url
KV_REST_API_TOKEN=replace-with-vercel-kv-token
